<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Services\Historico\**" />
    <Compile Remove="Services\Limpeza\**" />
    <Compile Remove="Services\Otimizacao\**" />
    <EmbeddedResource Remove="Services\Historico\**" />
    <EmbeddedResource Remove="Services\Limpeza\**" />
    <EmbeddedResource Remove="Services\Otimizacao\**" />
    <None Remove="Services\Historico\**" />
    <None Remove="Services\Limpeza\**" />
    <None Remove="Services\Otimizacao\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ReaLTaiizor" Version="3.8.2.1" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.12" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>